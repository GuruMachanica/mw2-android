# ---- game data: extracted from the retail disc, never commit ----
# Anchored with a leading slash, and that matters: "mw2/" on its own matches
# a directory of that name at any depth, and the app's Kotlin lives in
# android/app/src/main/java/com/mw2/recomp. That rule silently swallowed the
# whole app once -- it built, installed, and died on a manifest pointing at
# classes that were never committed. Anchor anything meant for the root.
/mw2/
*.xex
*.xexp
*.pe
*.iso

# ---- upstream tool checkout (121 MB + 6 submodules) ----
# Cloned and patched by build.sh; local changes live in patches/.
/XenonRecomp/

# ---- generated C++ (~2.2M lines, 64 MB) ----
/ppc/

# ---- generated switch tables (XenonAnalyse output, rebuilt by build.sh) ----
config/mw2_switch_tables.toml

# ---- build artifacts ----
/build/
/build-release/
/build-win*/
/out/

# ---- editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- generated runtime glue ----
runtime/kernel/stubs_generated.cpp
ppc/kernel_imports.txt
__pycache__/
*.pyc
/diagnosis/

# ---- the user's RenderDoc captures, hundreds of MB each ----
/captures/

# ---- saved games the runtime writes beside the binary ----
/saves/

# ---- the multiplayer executable's derived files (TITLE=mp ./build.sh) ----
/ppc_mp/
/build-mp/
/build-mp-release/
config/mw2mp_switch_tables.toml

# ---- the Android app's build output ----
android/build/
android/.gradle/
android/app/build/
android/local.properties
android/gradle/wrapper/gradle-wrapper.jar
*.apk
*.aab
*.keystore

# ---- fetched by android/fetch_deps.sh, somebody else's code ----
third_party/libadrenotools/

# ---- the native build's scratch directory ----
android/app/.cxx/
