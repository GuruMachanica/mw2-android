<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vibration for the controller's rumble; the player can turn it off. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reading the disc image the player supplies. On Android 13 and later
         a plain file path outside the app's own folders needs the manage
         permission; the app asks for it only when the player picks a file
         it cannot otherwise read, and works without it when the image sits
         in Android/data/<package>/files. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- System link between phones on the same network (MW2_NET_LINK). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:name=".MW2Application"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:isGame="true"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:theme="@style/Theme.MW2">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The run lives in its own process. It is ended by killing that
             process, which is the only way to stop a guest that is inside
             recompiled code, and it must not take the launcher with it. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|navigation|keyboard|touchscreen|smallestScreenSize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".DriverActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".InstallActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".FileBrowserActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>
</manifest>
