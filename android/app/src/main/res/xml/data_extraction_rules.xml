<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing here is worth backing up to a cloud and plenty of it is large: the game files are gigabytes, the caches are rebuilt on demand, and the saves belong to the phone the game was played on. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
