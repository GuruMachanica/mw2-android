<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0E12"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/graphics_driver"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/driver_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#141A21"
        android:padding="12dp"
        android:textColor="#C8D0D8"
        android:textSize="13sp" />

    <TextView
        style="@style/SettingHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/driver_hint" />

    <Button
        android:id="@+id/import_driver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/import_driver" />

    <ListView
        android:id="@+id/driver_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:divider="#1E262F"
        android:dividerHeight="1dp" />
</LinearLayout>
