<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#090D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Top Header: Logo + Title + Native Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#F0F6FC"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/subtitle"
                    android:textColor="#8B949E"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="ARM64"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Hero Card (Deployment Status + Launch) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#10B981" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="DEPLOYMENT STATUS"
                    android:textColor="#8B949E"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#C9D1D9"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="sans-serif" />

            <!-- Primary Play / Deploy Button -->
            <Button
                android:id="@+id/play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="60dp"
                android:background="@drawable/bg_button_play"
                android:text="@string/play"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:stateListAnimator="@null" />

            <!-- Direct Launch Toggle -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/direct_launch_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Direct launch on app start"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Secondary Option: Install Game / Select Source -->
        <Button
            android:id="@+id/install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_button_action"
            android:textColor="#C9D1D9"
            android:text="@string/install_game"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null" />

        <!-- Control Row: Driver, Settings, Logs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/driver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_button_action"
                android:textColor="#C9D1D9"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/graphics_driver"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_button_action"
                android:textColor="#C9D1D9"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/log"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_button_action"
                android:textColor="#C9D1D9"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/view_log"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Device & Hardware Info Footer -->
        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#484F58"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans-serif" />
    </LinearLayout>
</ScrollView>
